# A classic token with no scopes is enough: the app only reads public repos and your star state.
# Own name because --env-file never overrides a GITHUB_TOKEN already set in the environment.
UNSTARRED_TOKEN=

# Secret you type in the browser before hiding or unhiding a repo. Anyone with it can edit the hidden list.
HIDE_KEY=

# Upstash Redis REST settings for the shared hidden list. `vercel env pull .env.local` fills these
# once Upstash is connected to the Vercel project. Without them the page falls back to browser storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
